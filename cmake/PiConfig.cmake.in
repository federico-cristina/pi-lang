@PACKAGE_INIT@

# Pi CMake Package Config File
# This file is used by find_package(Pi) to locate and configure the Pi libraries

# Find dependencies if any (none currently, but good practice for future)
# include(CMakeFindDependencyMacro)
# find_dependency(SomeDep REQUIRED)

# Include the exported targets (defines pi::common, pi::runtime, pi::compiler, pi::svm)
include("${CMAKE_CURRENT_LIST_DIR}/PiTargets.cmake")

# Provide package version variables for user convenience
set(PI_VERSION "@PROJECT_VERSION@")
set(PI_VERSION_MAJOR "@PROJECT_VERSION_MAJOR@")
set(PI_VERSION_MINOR "@PROJECT_VERSION_MINOR@")
set(PI_VERSION_PATCH "@PROJECT_VERSION_PATCH@")

# Check that all requested components are available
check_required_components(Pi)
